{
  "name": "livechat-system-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "scan:secrets": "node scripts/formal_secret_scan.mjs",
    "check:config": "node scripts/validate-jsonc.mjs",
    "db:migrate:local": "wrangler d1 execute livechat-db --local --file=migrations/0001_init.sql --file=migrations/0002_wecom_settings.sql",
    "db:migrate:remote": "wrangler d1 execute livechat-db --remote --file=migrations/0001_init.sql --file=migrations/0002_wecom_settings.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "hono": "^4.6.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
